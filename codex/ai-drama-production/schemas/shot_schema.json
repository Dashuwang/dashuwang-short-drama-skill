{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "15 Second Shot Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "shot_id": { "type": "string", "minLength": 1 },
    "episode_id": { "type": "string" },
    "scene_id": { "type": "string", "minLength": 1 },
    "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 20, "default": 15 },
    "story_goal": { "type": "string" },
    "emotion_goal": { "type": "string" },
    "characters": { "type": "array", "items": { "type": "string" } },
    "character_states": { "type": "object", "additionalProperties": { "type": "string" } },
    "assets": { "type": "array", "items": { "type": "string" } },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "beat_id": { "type": "string" },
          "trigger": { "type": "string" },
          "visible_event": { "type": "string" },
          "change": { "type": "string" },
          "next_trigger": { "type": "string" }
        },
        "required": ["beat_id", "visible_event", "change"]
      }
    },
    "action": { "type": "object" },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "speaker": { "type": "string" },
          "text": { "type": "string" },
          "tone": { "type": "string" },
          "emotion": { "type": "string" },
          "delivery_mode": { "type": "string", "enum": ["before_action", "during_action", "on_action_completion", "after_action", "during_reaction"] },
          "action_anchor": { "type": "string" },
          "must_overlap_action": { "type": "boolean" },
          "after_dialogue_action": { "type": "string" }
        },
        "required": ["speaker", "text"]
      }
    },
    "pacing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "target_beat_count": { "type": "integer", "minimum": 1 },
        "actual_beat_count": { "type": "integer", "minimum": 1 },
        "estimated_story_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "density_review": { "type": "string" }
      }
    },
    "camera": { "type": "object" },
    "lighting": { "type": "object" },
    "continuity": { "type": "object" },
    "status": { "type": "string", "enum": ["draft", "review", "approved", "deprecated"] },
    "version": { "type": "string" }
  },
  "required": ["shot_id", "episode_id", "scene_id", "duration", "story_goal", "status", "version"]
}
